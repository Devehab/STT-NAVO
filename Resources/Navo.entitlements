<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for microphone access under the hardened runtime. Navo is not sandboxed:
	     it needs Accessibility (global key, paste) and launches its local Python engine. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
