index 00000000..174a49d7
--- /dev/null
+++ b/mlx_vlm/models/jais_asr/language.py
@@ -0,0 +1,242 @@
+"""Choosing the Jais-ASR transcription language in advance (language pin).
+
+Same rule as `language.py` of the Jais-ASR model repository, for MLX arrays.
+
+By default Jais-ASR decides for itself, at one generated position, between abstaining
+(`[IFM-NoTranscript]`) and a language/dialect tag. Pinning restricts which tag is written
+without taking away the model's ability to abstain: the two decisions are read
+separately, from the same untouched scores,
+
+    abstain  iff  score(IF) > max over ALL tags      <- the model's own best tag
+    else          argmax over the ALLOWED tags       <- the caller's pin
+
+so the abstain/transcribe decision does not change; only which tag gets written does.
+The other way to choose the language, prefill (`[EG]` written at the end of the prompt),
+needs no code but can never abstain.
+
+Usage: `generate(model, processor, prompt, audio=[...], language="EG")`, or
+`mlx_vlm.generate ... --language EG`. `language` accepts an ISO 639-1 code ("ar" keeps
+every Arabic tag, so the model still chooses the dialect), a model tag ("EG", "msa"),
+or a list of either.
+"""
+
+import math
+
+import mlx.core as mx
+
+# Token ids of the Jais-ASR tokenizer (model repository `postprocess.py`).
+BRACKET_OPEN_ID = 60  # '['
+BRACKET_CLOSE_ID = 62  # ']'
+THINK_OPEN_ID = 250029  # <ifm|think>
+THINK_CLOSE_ID = 250030  # '</ifm|think>', the last token of every rendered prompt
+REFUSAL_DECISION_ID = 5126  # 'IF', the continuation of [IFM-NoTranscript]
+
+#: decision-token id -> tag surface. 24 tags, all distinct.
+LANGUAGE_TAG_IDS = {
+    226606: "msa",  # Modern Standard Arabic
+    272: "en",
+    2075: "fr",
+    273: "es",
+    286: "it",
+    7646: "EG",
+    8048: "SA",
+    6101: "MA",
+    29354: "IQ",
+    23129: "JO",
+    20056: "SY",
+    27526: "QA",
+    64489: "DZ",
+    23852: "LB",
+    5594: "OM",
+    28472: "YE",
+    43852: "TN",
+    17604: "MR",
+    25893: "KW",
+    9373: "SD",
+    12933: "LY",
+    5402: "AE",
+    4295: "PS",
+    41905: "BH",
+}
+TAG_TO_ID = {t: i for i, t in LANGUAGE_TAG_IDS.items()}
+
+#: the 19 country codes plus MSA -- everything the model treats as Arabic
+ARABIC_TAGS = (
+    "msa",
+    "EG",
+    "SA",
+    "MA",
+    "IQ",
+    "JO",
+    "SY",
+    "QA",
+    "DZ",
+    "LB",
+    "OM",
+    "YE",
+    "TN",
+    "MR",
+    "KW",
+    "SD",
+    "LY",
+    "AE",
+    "PS",
+    "BH",
+)
+
+#: ISO 639-1 -> the tags that count as that language. `ar` deliberately maps to ALL the
+#: Arabic tags: pinning "Arabic" should let the model keep choosing the dialect.
+ISO_TO_TAGS = {
+    "ar": ARABIC_TAGS,
+    "en": ("en",),
+    "fr": ("fr",),
+    "es": ("es",),
+    "it": ("it",),
+}
+
+
+def resolve_language(language):
+    """Normalise a caller's language spec into the list of allowed tags.
+
+    Accepts an ISO 639-1 code ("ar"), a model tag ("EG", "msa"), a list of either, or
+    None for "no restriction". Raises on anything unrecognised rather than silently
+    falling back to auto -- a typo that quietly disables pinning is worse than an error.
+    """
+    if language is None:
+        return None
+    if not isinstance(language, (str, list, tuple)):
+        raise ValueError(
+            "language must be a tag, ISO code, non-empty list/tuple, or None"
+        )
+    specs = [language] if isinstance(language, str) else list(language)
+    if not specs:
+        raise ValueError("language list must not be empty; use None for no restriction")
+    tags = []
+    for s in specs:
+        if not isinstance(s, str):
+            raise ValueError("each language must be a string tag or ISO code")
+        s = s.strip()
+        if s in ISO_TO_TAGS:
+            tags.extend(ISO_TO_TAGS[s])
+        elif s in TAG_TO_ID:
+            tags.append(s)
+        elif s.lower() in ISO_TO_TAGS:
+            tags.extend(ISO_TO_TAGS[s.lower()])
+        else:
+            raise ValueError(
+                f"unknown language {s!r}. Use an ISO 639-1 code "
+                f"({', '.join(sorted(ISO_TO_TAGS))}) or a model tag "
+                f"({', '.join(sorted(TAG_TO_ID))})."
+            )
+    seen, out = set(), []
+    for t in tags:
+        if t not in seen:
+            seen.add(t)
+            out.append(t)
+    return out
+
+
+def has_prefilled_tag(prompt_ids):
+    """Only a complete known [language] suffix counts as a prompt prefill."""
+    return (
+        len(prompt_ids) >= 3
+        and int(prompt_ids[-3]) == BRACKET_OPEN_ID
+        and int(prompt_ids[-2]) in LANGUAGE_TAG_IDS
+        and int(prompt_ids[-1]) == BRACKET_CLOSE_ID
+    )
+
+
+def has_open_thinking(prompt_ids):
+    """Whether the final thinking delimiter in the prompt is an opening one."""
+    for index in range(len(prompt_ids) - 1, -1, -1):
+        token_id = int(prompt_ids[index])
+        if token_id == THINK_CLOSE_ID:
+            return False
+        if token_id == THINK_OPEN_ID:
+            return True
+    return False
+
+
+def _keep_only(logits, token_id):
+    keep = logits[token_id]
+    if not math.isfinite(keep.item()):
+        raise ValueError(
+            "language pin selected a token without a finite score; check conflicting "
+            "token constraints or invalid logits"
+        )
+    return mx.where(mx.arange(logits.shape[-1]) == token_id, logits, -mx.inf)
+
+
+class LanguagePin:
+    """Pin the language while leaving the abstention decision untouched."""
+
+    def __init__(self, language, force_bracket=True):
+        self.tags = resolve_language(language)
+        self.allowed_ids = [TAG_TO_ID[t] for t in self.tags] if self.tags else None
+        self.all_tag_ids = list(LANGUAGE_TAG_IDS)
+        self.force_bracket = force_bracket
+
+    def apply(self, generated_ids, logits, *, thinking=False):
+        """Constrain the decision zone and return the score vector.
+
+        `generated_ids` excludes the prompt. If the prompt opens a thinking block, pass
+        thinking=True: scores are untouched until the generated closing marker, and
+        the decision zone starts immediately after that marker.
+        """
+        if self.allowed_ids is None:
+            return logits
+        if thinking:
+            for index, token_id in enumerate(generated_ids):
+                if int(token_id) == THINK_CLOSE_ID:
+                    generated_ids = generated_ids[index + 1 :]
+                    break
+            else:
+                return logits
+        n_generated = len(generated_ids)
+        if n_generated > 2:
+            return logits
+        if n_generated == 0:
+            return _keep_only(logits, BRACKET_OPEN_ID) if self.force_bracket else logits
+        # With force_bracket=False, non-tag output must remain untouched.
+        if int(generated_ids[0]) != BRACKET_OPEN_ID:
+            return logits
+        if n_generated == 2:
+            if int(generated_ids[1]) in self.allowed_ids:
+                return _keep_only(logits, BRACKET_CLOSE_ID)
+            return logits  # Let [IFM-NoTranscript] continue naturally.
+
+        # Read both decisions before masking. Refusal must strictly beat every tag;
+        # ties transcribe. This is a deterministic score rule, not preservation of
+        # the probability distribution of unconstrained sampling.
+        ids = self.all_tag_ids + [REFUSAL_DECISION_ID]
+        scores = dict(zip(ids, logits[mx.array(ids)].astype(mx.float32).tolist()))
+        best_tag = max(self.all_tag_ids, key=lambda i: scores[i])
+        abstains = scores[REFUSAL_DECISION_ID] > scores[best_tag]
+        keep_id = (
+            REFUSAL_DECISION_ID
+            if abstains
+            else max(self.allowed_ids, key=lambda i: scores[i])
+        )
+        return _keep_only(logits, keep_id)
+
+    def for_mlx(self, prompt_ids):
+        """mlx-vlm logits processor: (tokens, logits [1, vocab]) -> logits.
+
+        mlx-vlm passes the end of the prompt (what its chunked prefill left) on the first
+        call and one more token per call after that, so the generated tokens are the ones
+        after the length seen on the first call.
+        """
+        if has_prefilled_tag(prompt_ids):
+            raise ValueError("language cannot be combined with a prefilled language tag")
+        thinking = has_open_thinking(prompt_ids)
+        prompt_len = []
+
+        def processor(tokens, logits):
+            if not prompt_len:
+                prompt_len.append(len(tokens))
+            generated = tokens[prompt_len[0]:]
+            if self.allowed_ids is None or len(generated) > 2 and not thinking:
+                return logits
+            return self.apply(generated.tolist(), logits[0], thinking=thinking)[None]
+
+        return processor
