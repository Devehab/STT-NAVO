+class GroupedRMSNorm(nn.Module):
+    """RMSNorm over ``groups`` equal slices of the last axis (K2HorizonRMSNorm).
+
+    Statistics and the weight product are computed in float32, then cast back,
+    as in the reference implementation.
+    """
+
+    def __init__(self, dims: int, groups: int = 1, eps: float = 1e-6):
+        super().__init__()
+        if dims % groups:
+            raise ValueError(f"hidden size {dims} is not divisible by {groups} groups")
+        self.weight = mx.ones((dims,))
+        self.groups = groups
+        self.eps = eps
+
+    def __call__(self, x: mx.array) -> mx.array:
+        if self.groups == 1:
+            return mx.fast.rms_norm(x, self.weight, self.eps)
+        shape = x.shape
+        y = x.astype(mx.float32).reshape(*shape[:-1], self.groups, shape[-1] // self.groups)
+        y = y * mx.rsqrt(mx.mean(mx.square(y), axis=-1, keepdims=True) + self.eps)
+        return (self.weight.astype(mx.float32) * y.reshape(shape)).astype(x.dtype)
+
