+from dataclasses import dataclass
+from typing import List, Optional, Union
+
+from ..base import BaseModelConfig
+from ..k2_horizon.config import ModelConfig as TextConfig
+from ..qwen3_omni_moe.config import AudioConfig
+
+
+@dataclass
+class ModelConfig(BaseModelConfig):
+    text_config: TextConfig = None
+    audio_config: AudioConfig = None
+    model_type: str = "jais_asr"
+    audio_token_id: int = 250062
+    audio_start_token_id: int = 250035
+    audio_end_token_id: int = 250036
+    projector_hidden_act: str = "gelu"
+    eos_token_id: Optional[Union[int, List[int]]] = None
+
+    def __post_init__(self):
+        if self.text_config is None or isinstance(self.text_config, dict):
+            self.text_config = TextConfig.from_dict(self.text_config or {})
+        if self.audio_config is None or isinstance(self.audio_config, dict):
+            self.audio_config = AudioConfig.from_dict(self.audio_config or {})
+
+
+__all__ = ["AudioConfig", "ModelConfig", "TextConfig"]
diff --git a/mlx_vlm/models/jais_asr/jais_asr.py b/mlx_vlm/models/jais_asr/jais_asr.py
