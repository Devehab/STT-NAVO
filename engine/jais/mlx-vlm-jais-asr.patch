index 00000000..e5a79f66
--- /dev/null
+++ b/mlx_vlm/models/jais_asr/jais_asr.py
@@ -0,0 +1,141 @@
+"""Jais-ASR: Qwen3-Omni audio encoder + projector + K2-Horizon decoder.
+
+Mirrors ``JaisASRForConditionalGeneration`` of MBZUAI-Paris/Jais-ASR: the audio
+encoder output is projected to the decoder width and written into the
+``<|ifm|audio|>`` placeholder positions of the prompt, in order.
+"""
+
+from typing import Optional
+
+import mlx.core as mx
+import mlx.nn as nn
+
+from ..base import InputEmbeddingsFeatures, LanguageModelOutput
+from ..k2_horizon.language import LanguageModel
+from ..qwen3_omni_moe.audio import AudioModel
+from .config import ModelConfig
+from .language import LanguagePin
+
+
+class Projector(nn.Module):
+    """LayerNorm -> Linear -> GELU -> Linear (audio width -> decoder width)."""
+
+    def __init__(self, config: ModelConfig):
+        super().__init__()
+        in_dim = config.audio_config.output_dim
+        out_dim = config.text_config.hidden_size
+        if config.projector_hidden_act != "gelu":
+            raise ValueError(f"Unsupported projector activation: {config.projector_hidden_act}")
+        self.norm = nn.LayerNorm(in_dim)
+        self.linear_1 = nn.Linear(in_dim, out_dim)
+        self.linear_2 = nn.Linear(out_dim, out_dim)
+
+    def __call__(self, x: mx.array) -> mx.array:
+        return self.linear_2(nn.gelu(self.linear_1(self.norm(x))))
+
+
+class Model(nn.Module):
+    def __init__(self, config: ModelConfig):
+        super().__init__()
+        self.config = config
+        self.model_type = config.model_type
+        self.audio_tower = AudioModel(config.audio_config)
+        # Named like other mlx-vlm projectors so quantization leaves it in full precision.
+        self.multi_modal_projector = Projector(config)
+        self.language_model = LanguageModel(config.text_config)
+
+    def get_audio_features(
+        self,
+        input_features: mx.array,
+        feature_attention_mask: Optional[mx.array] = None,
+    ) -> mx.array:
+        """Pack the clips of a batch, encode them, project to the decoder width."""
+        if input_features.ndim == 2:
+            input_features = input_features[None]
+        batch, _, frames = input_features.shape
+        if feature_attention_mask is None:
+            lengths = [frames] * batch
+        else:
+            lengths = [int(n) for n in feature_attention_mask.sum(axis=-1).tolist()]
+        packed = mx.concatenate(
+            [input_features[i, :, :n] for i, n in enumerate(lengths)], axis=-1
+        )
+        dtype = self.audio_tower.conv_out.weight.dtype
+        hidden = self.audio_tower(
+            packed.astype(dtype), feature_lens=mx.array(lengths, dtype=mx.int32)
+        )
+        return self.multi_modal_projector(hidden)
+
+    def get_input_embeddings(
+        self,
+        input_ids: Optional[mx.array] = None,
+        pixel_values: Optional[mx.array] = None,
+        **kwargs,
+    ) -> InputEmbeddingsFeatures:
+        embeds = self.language_model.model.embed_tokens(input_ids)
+        input_features = kwargs.get("input_features")
+        if input_features is None:
+            return InputEmbeddingsFeatures(inputs_embeds=embeds)
+        placeholders = input_ids == self.config.audio_token_id
+        n_placeholders = int(placeholders.sum())
+        if n_placeholders == 0:
+            return InputEmbeddingsFeatures(inputs_embeds=embeds)
+
+        audio = self.get_audio_features(
+            input_features, kwargs.get("feature_attention_mask")
+        ).astype(embeds.dtype)
+        if audio.shape[0] != n_placeholders:
+            raise ValueError(
+                f"Audio placeholder tokens ({n_placeholders}) != audio frames "
+                f"({audio.shape[0]}); build prompts with the Jais-ASR processor."
+            )
+        # Placeholders are filled in sequence order, as masked_scatter does.
+        flat = placeholders.reshape(-1)
+        order = mx.maximum(mx.cumsum(flat.astype(mx.int32)) - 1, 0)
+        hidden = embeds.shape[-1]
+        merged = mx.where(flat[:, None], audio[order], embeds.reshape(-1, hidden))
+        return InputEmbeddingsFeatures(inputs_embeds=merged.reshape(embeds.shape))
+
+    def __call__(
+        self,
+        input_ids: mx.array,
+        pixel_values: Optional[mx.array] = None,
+        mask: Optional[mx.array] = None,
+        cache=None,
+        **kwargs,
+    ) -> LanguageModelOutput:
+        inputs_embeds = self.get_input_embeddings(input_ids, **kwargs).inputs_embeds
+        return self.language_model(input_ids, cache=cache, inputs_embeds=inputs_embeds)
+
+    def sanitize(self, weights):
+        """Map Jais-ASR (Transformers) names to this module tree; idempotent."""
+        renamed = {}
+        for key, value in weights.items():
+            if key.startswith("model.audio_tower."):
+                key = key.replace("model.audio_tower.", "audio_tower.", 1)
+            elif key.startswith("model.embed_audio."):
+                key = key.replace("model.embed_audio.", "multi_modal_projector.", 1)
+            elif key.startswith("model.language_model."):
+                key = key.replace("model.language_model.", "language_model.model.", 1)
+            elif key == "lm_head.weight":
+                key = "language_model.lm_head.weight"
+            renamed[key] = value
+        return renamed
+
+    def generation_processors(self, input_ids, options):
+        """Logits processors for the generate options of this model.
+
+        `language` pins the transcription language (see language.py). It is removed
+        from `options` so it never reaches the forward pass.
+        """
+        language = options.pop("language", None)
+        if language is None:
+            return []
+        return [LanguagePin(language).for_mlx(input_ids.reshape(-1).tolist())]
+
+    def make_cache(self):
+        return self.language_model.make_cache()
+
+    @property
+    def layers(self):
+        return self.language_model.layers
